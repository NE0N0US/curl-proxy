{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"functions": {
		"api/*": {
			"supportsCancellation": true,
			"includeFiles": "**/*.{html,md}",
			"maxDuration": "max"
		}
	},
	"rewrites": [
		{
			"source": "/",
			"destination": "/api/proxy"
		},
		{
			"source": "/url-artisan/(.*)",
			"destination": "/dist/url-artisan"
		}
	],
	"outputDirectory": "dist"
}
